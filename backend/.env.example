# ==========================================
# Backend API Production Environment
# ==========================================

# Server execution environment (production | development | test)
NODE_ENV=production

# Server Port
PORT=5000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/retailer_db?schema=public"

# Secure JWT signing key (use a strong random 64-character secret in production)
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"

# Allowed CORS origins (comma-separated domains, or * for all)
CORS_ORIGIN="*"

# Initial Admin credentials seeded on first database setup
ADMIN_SEED_USERNAME="admin"
ADMIN_SEED_PASSWORD="AdminPassword@123"

# Optional: Serve exported frontend static bundle from backend (true | false)
SERVE_STATIC_WEB=false
