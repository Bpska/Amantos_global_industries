# ==============================================================================
# Multi-stage Production Dockerfile: Admin Panel + Seller Web App + Nginx Proxy
# Configured for Domain: industri.heylane.in
# ==============================================================================

# --- Stage 1: Build Admin Web Portal (React + Vite) ---
FROM node:20-alpine AS admin-builder

WORKDIR /app

COPY admin-web/package*.json ./
RUN npm ci

COPY admin-web/ ./
ENV VITE_BASE_PATH=/admin/
RUN npm run build

# --- Stage 2: Build Seller / Staff Web PWA (Expo Web) ---
FROM node:20-alpine AS seller-builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . ./
ENV EXPO_PUBLIC_API_URL=https://industri.heylane.in
RUN npx expo export --platform web

# --- Stage 3: High-Performance Production Nginx Server ---
FROM nginx:1.27-alpine

RUN apk add --no-cache openssl

# Remove default configuration & dummy files
RUN rm -rf /etc/nginx/conf.d/* /usr/share/nginx/html/*

# Copy compiled static assets for both web panels
COPY --from=seller-builder /app/dist /var/www/html/seller
COPY --from=admin-builder /app/dist /var/www/html/admin

# Copy Nginx configurations
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/conf.d/industri.heylane.in.conf /etc/nginx/conf.d/industri.heylane.in.conf

# Copy and setup entrypoint
COPY docker/nginx/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Webroot directory for Certbot ACME challenges
RUN mkdir -p /var/www/certbot /etc/letsencrypt

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]

