# ==============================================================================
# Production Environment Configuration for industri.heylane.in
# ==============================================================================

# Primary Domain Name
DOMAIN=industri.heylane.in

# Frontend API Endpoint
EXPO_PUBLIC_API_URL=https://industri.heylane.in

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=industri_secure_db_pass_2026
POSTGRES_DB=retailer_db
POSTGRES_PORT=5432

# Application Ports & Node Settings
PORT=5000
NODE_ENV=production

# Exposed Server Host Ports (Dedicated Ports to Prevent Server Conflicts)
WEB_PORT=8012
API_PORT=5007
DB_HOST_PORT=5441

# Security Keys
JWT_SECRET=industri-jwt-production-secret-token-key-2026-heylane

# Initial System Administrator Credentials
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=admin@123

# Allowed CORS Origins
CORS_ORIGIN=https://industri.heylane.in,http://industri.heylane.in,https://www.industri.heylane.in,https://admin.industri.heylane.in

